NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pioneer
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://admin.pioneerlegacyworks.com,https://books.pioneerlegacyworks.com,https://pioneerlegacyworks.com,https://www.pioneerlegacyworks.com,https://pioneeroutdoorservices.com,https://www.pioneeroutdoorservices.com,https://del-985.github.io
LOG_LEVEL=info
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=pioneer_session
# Canonical production API origin: https://api.pioneerlegacyworks.com
# Pioneer Outdoor Services production origins: https://pioneeroutdoorservices.com and https://www.pioneeroutdoorservices.com
# Outdoor Services GitHub Pages fallback origin: https://del-985.github.io
# Leave SESSION_COOKIE_DOMAIN unset for the normal host-only API session cookie.
# Set it only if explicit cross-subdomain cookie sharing is required.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Notification email delivery. Production currently uses Zoho Mail.
# Zoho supports STARTTLS on port 587 and SSL on port 465.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=del@pioneerlegacyworks.com
# SMTP_PASSWORD=use-the-mailbox-password-or-app-specific-password
# SMTP_FROM=Pioneer Legacy Works <del@pioneerlegacyworks.com>
# PASSWORD_RESET_URL=https://admin.pioneerlegacyworks.com/reset-password
NOTIFICATION_BATCH_SIZE=25

# Optional S3-compatible object storage for file/attachment bytes.
# PostgreSQL stores metadata and bookkeeping scope; binary bytes live in object storage.
# OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=pioneer-files
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_SECONDS=900
