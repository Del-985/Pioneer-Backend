NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pioneer
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://admin.pioneerlegacyworks.com
LOG_LEVEL=info
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=pioneer_session
# Leave SESSION_COOKIE_DOMAIN unset while the API is hosted on onrender.com.
# If the API later moves to api.pioneerlegacyworks.com, it can be set to .pioneerlegacyworks.com.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional notification worker configuration.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Pioneer Legacy Works <no-reply@example.com>
# PASSWORD_RESET_URL=https://admin.pioneerlegacyworks.com/reset-password
NOTIFICATION_BATCH_SIZE=25
