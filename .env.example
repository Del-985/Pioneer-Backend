NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pioneer
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://admin.pioneerlegacyworks.com,https://books.pioneerlegacyworks.com,https://pioneerlegacyworks.com,https://www.pioneerlegacyworks.com,https://pioneeroutdoorservices.com,https://www.pioneeroutdoorservices.com,https://customer.pioneeroutdoorservices.com,https://del-985.github.io
LOG_LEVEL=info
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=pioneer_session
CUSTOMER_SESSION_COOKIE_NAME=pioneer_customer_session
# Canonical production API origin: https://api.pioneerlegacyworks.com
# Pioneer Outdoor Services production origins: https://pioneeroutdoorservices.com, https://www.pioneeroutdoorservices.com, and https://customer.pioneeroutdoorservices.com
# Outdoor Services GitHub Pages fallback origin: https://del-985.github.io
# Leave SESSION_COOKIE_DOMAIN unset for the normal host-only API staff session cookie.
# Customer portal sessions are always host-only and use their own cookie name.
# Set SESSION_COOKIE_DOMAIN only if explicit staff cross-subdomain cookie sharing is required.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Platform Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Notification email delivery. Production uses Zoho Mail when authenticated SMTP is configured.
# Zoho supports STARTTLS on port 587 and SSL on port 465.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=del@pioneerlegacyworks.com
# SMTP_PASSWORD=use-the-mailbox-password-or-app-specific-password
# SMTP_FROM=Pioneer Outdoor Services <del@pioneerlegacyworks.com>
# PASSWORD_RESET_URL=https://admin.pioneerlegacyworks.com/reset-password
NOTIFICATION_BATCH_SIZE=25

# SMS delivery through TextBee using the Pioneer Android phone and its existing SIM/number.
# TEXTBEE_API_KEY is required to enable SMS delivery.
# TEXTBEE_DEVICE_ID is optional but recommended so production always uses the dedicated business phone.
# TEXTBEE_SIM_SUBSCRIPTION_ID is optional for dual-SIM devices.
# Keep TEXTBEE_WEBHOOK_SECRET ready for inbound SMS/STOP handling when the TextBee webhook is enabled.
TEXTBEE_API_BASE_URL=https://api.textbee.dev/api/v1
# TEXTBEE_API_KEY=replace-with-textbee-api-key
# TEXTBEE_DEVICE_ID=replace-with-registered-device-id
# TEXTBEE_SIM_SUBSCRIPTION_ID=1
# TEXTBEE_WEBHOOK_SECRET=replace-with-textbee-webhook-signing-secret

# Optional S3-compatible object storage for file/attachment bytes.
# PostgreSQL stores metadata and bookkeeping scope; binary bytes live in object storage.
# OBJECT_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=pioneer-files
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_PRESIGN_SECONDS=900
